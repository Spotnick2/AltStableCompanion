<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:AltStableCompanion.App"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="AltStableCompanion.App.MainWindow"
        x:DataType="app:MainViewModel"
        Title="AltStable Companion"
        Icon="/Assets/tray.ico"
        Width="540" Height="720" MinWidth="440" MinHeight="480"
        Background="{DynamicResource BodyBrush}"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly"
        WindowStartupLocation="CenterScreen">

  <!-- Every colour is a resource with a name that says what it is FOR. The glass themes are a
       second set under the same names; nothing below has a colour of its own. -->
  <Window.Resources>
    <SolidColorBrush x:Key="BodyBrush" Color="#0E1420" />
    <SolidColorBrush x:Key="PaneBrush" Color="#151D2B" />
    <SolidColorBrush x:Key="DataBrush" Color="#0B1018" />
    <SolidColorBrush x:Key="RimBrush" Color="#2B3850" />
    <SolidColorBrush x:Key="TextBrush" Color="#E8EEF7" />
    <SolidColorBrush x:Key="DimBrush" Color="#9AA8BD" />
    <SolidColorBrush x:Key="LinkBrush" Color="#5AA9FF" />
    <SolidColorBrush x:Key="GoodBrush" Color="#4ADE80" />
    <SolidColorBrush x:Key="GoodPaneBrush" Color="#10301F" />
    <SolidColorBrush x:Key="InfoBrush" Color="#5AA9FF" />
    <SolidColorBrush x:Key="InfoPaneBrush" Color="#11233A" />
    <SolidColorBrush x:Key="AttentionBrush" Color="#F0A23A" />
    <SolidColorBrush x:Key="AttentionPaneBrush" Color="#33240E" />
    <SolidColorBrush x:Key="ProblemBrush" Color="#F26D6D" />
    <SolidColorBrush x:Key="ProblemPaneBrush" Color="#351616" />
  </Window.Resources>

  <Window.Styles>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.dim">
      <Setter Property="Foreground" Value="{DynamicResource DimBrush}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.warn">
      <Setter Property="Foreground" Value="{DynamicResource AttentionBrush}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="19" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.heading">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Border.pane">
      <Setter Property="Background" Value="{DynamicResource PaneBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource RimBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,10" />
    </Style>
    <Style Selector="Border.data">
      <Setter Property="Background" Value="{DynamicResource DataBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource RimBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!-- The headline wears the colour of what it says. -->
    <Style Selector="Border.headline">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="Background" Value="{DynamicResource PaneBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource RimBrush}" />
    </Style>
    <Style Selector="Border.headline.good">
      <Setter Property="Background" Value="{DynamicResource GoodPaneBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource GoodBrush}" />
    </Style>
    <Style Selector="Border.headline.info">
      <Setter Property="Background" Value="{DynamicResource InfoPaneBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InfoBrush}" />
    </Style>
    <Style Selector="Border.headline.attention">
      <Setter Property="Background" Value="{DynamicResource AttentionPaneBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AttentionBrush}" />
    </Style>
    <Style Selector="Border.headline.problem">
      <Setter Property="Background" Value="{DynamicResource ProblemPaneBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ProblemBrush}" />
    </Style>
    <Style Selector="Border.headline.good TextBlock.title">
      <Setter Property="Foreground" Value="{DynamicResource GoodBrush}" />
    </Style>
    <Style Selector="Border.headline.attention TextBlock.title">
      <Setter Property="Foreground" Value="{DynamicResource AttentionBrush}" />
    </Style>
    <Style Selector="Border.headline.problem TextBlock.title">
      <Setter Property="Foreground" Value="{DynamicResource ProblemBrush}" />
    </Style>

    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
    </Style>
    <!-- The title strip's buttons: flat, and lit when the pointer is on them. -->
    <Style Selector="Button.caption">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.caption:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#33FFFFFF" />
    </Style>
    <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#E0C42B1C" />
    </Style>
    <!-- The slot a thumbnail sits in: fixed, so a row without one keeps its shape -->
    <Style Selector="Border.thumb">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="48" />
      <Setter Property="Background" Value="{DynamicResource PaneBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource RimBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ToolTip">
      <Setter Property="MaxWidth" Value="380" />
    </Style>
    <Style Selector="Ellipse.dot">
      <Setter Property="Width" Value="9" />
      <Setter Property="Height" Value="9" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <!-- The client area reaches the top edge, so the glass does. The title strip is drawn here,
       with the roles that make it a title bar: drag, double-click to maximise, and Windows'
       own snap layouts on the maximise button. -->
  <Grid RowDefinitions="Auto,*" Margin="0,0,0,14" RowSpacing="10">

    <Grid Grid.Row="0" Height="34" ColumnDefinitions="Auto,*,Auto,Auto,Auto"
          chrome:WindowDecorationProperties.ElementRole="TitleBar" Background="{DynamicResource PaneBrush}">
      <Image x:Name="StripIcon" Grid.Column="0" Width="18" Height="18" Margin="12,0,8,0" VerticalAlignment="Center" />
      <TextBlock x:Name="StripTitle" Grid.Column="1" VerticalAlignment="Center" FontSize="13" />
      <Button Grid.Column="2" Classes="caption" Click="OnMinimize" ToolTip.Tip="Minimise"
              chrome:WindowDecorationProperties.ElementRole="MinimizeButton">
        <Path Data="M0,0 L10,0" Stroke="{DynamicResource TextBrush}" StrokeThickness="1" />
      </Button>
      <Button x:Name="MaximizeButton" Grid.Column="3" Classes="caption" Click="OnMaximize"
              chrome:WindowDecorationProperties.ElementRole="MaximizeButton">
        <Path x:Name="MaximizeGlyphPath" Stroke="{DynamicResource TextBrush}" StrokeThickness="1" />
      </Button>
      <Button Grid.Column="4" Classes="caption close" Click="OnClose" ToolTip.Tip="Close (the app stays in the tray)"
              chrome:WindowDecorationProperties.ElementRole="CloseButton">
        <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{DynamicResource TextBrush}" StrokeThickness="1" />
      </Button>
    </Grid>

   <!-- Settings is a page: it takes the dashboard's place until Back. -->
   <StackPanel Grid.Row="1" Spacing="10" Margin="14,0" VerticalAlignment="Top" IsVisible="{Binding ShowSettings}">
    <Border Classes="pane">
      <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button Classes="link" Content="← Back" Command="{Binding ToggleSettings}" VerticalAlignment="Center" />
          <TextBlock Classes="heading" Text="Settings" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Classes="dim" Text="World of Warcraft folder" Margin="0,6,0,0" />
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
          <TextBox Grid.Column="0" Text="{Binding InstallPath, Mode=OneWay}" IsReadOnly="True"
                   PlaceholderText="not set" />
          <Button Grid.Column="1" Content="Browse..." Click="OnBrowse" IsEnabled="{Binding CanChangeInstall}" />
          <Button Grid.Column="2" Content="Detect again" Command="{Binding DetectAgain}" />
        </Grid>
        <TextBlock Classes="dim" Text="{Binding InstallNote}" IsVisible="{Binding HasInstallNote}" />
        <TextBlock Classes="warn" Text="{Binding BrowseProblem}" IsVisible="{Binding HasBrowseProblem}" />
        <CheckBox IsChecked="{Binding Automatic}" Content="Process new captures automatically" Margin="0,6,0,0" />
        <TextBlock Classes="dim" Margin="28,-6,0,0"
                   Text="Otherwise new captures wait until you check for them." />
        <CheckBox IsChecked="{Binding KeepScreenshots}" Content="Keep original capture screenshots" />
        <TextBlock Classes="dim" Margin="28,-6,0,0"
                   Text="Otherwise those two files are deleted once the portrait is written. No other screenshot is ever touched." />
        <TextBlock Classes="dim" Text="Look" Margin="0,6,0,0" />
        <StackPanel Orientation="Horizontal" Spacing="14">
          <RadioButton GroupName="skin" Content="Clear glass" IsChecked="{Binding IsClear}" />
          <RadioButton GroupName="skin" Content="Smoked glass" IsChecked="{Binding IsSmoked}" />
          <RadioButton GroupName="skin" Content="Flat" IsChecked="{Binding IsFlat}" />
        </StackPanel>
      </StackPanel>
    </Border>
   </StackPanel>

   <!-- The dashboard: one container, hidden as one while Settings has the window. -->
   <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto" RowSpacing="10" IsVisible="{Binding !ShowSettings}">
   <StackPanel Grid.Row="0" Spacing="10" Margin="14,0">

    <!-- Which game, is the addon in it, how many accounts -->
    <Border Classes="pane">
      <!-- The game's name is the one piece that may wrap: at the window's minimum width the
           addon line and the link matter more than "Forever" on the same line. -->
      <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="14">
        <!-- Blizzard's emblem, resized and nothing else: see Reference/Blizzard/README.md -->
        <Grid Grid.Column="0" ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalAlignment="Center">
          <Image Grid.Column="0" Source="/Assets/wow-forever.png" Height="34" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding Game}" FontWeight="SemiBold" VerticalAlignment="Center" />
        </Grid>
        <Border Grid.Column="1" Width="1" Background="{DynamicResource RimBrush}" />
        <!-- Bounded: an Auto column measures with no width, and trimming needs one. -->
        <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center" MaxWidth="180">
          <!-- A Grid, not a horizontal StackPanel: the text has to know its width to trim. -->
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
            <Ellipse Grid.Column="0" Classes="dot" Fill="{DynamicResource GoodBrush}" IsVisible="{Binding AddonDetected}" />
            <Ellipse Grid.Column="0" Classes="dot" Fill="{DynamicResource ProblemBrush}" IsVisible="{Binding AddonMissing}" />
            <TextBlock Grid.Column="1" Text="{Binding Addon}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
          </Grid>
          <TextBlock Classes="dim" Text="{Binding Accounts}" Margin="16,0,0,0" IsVisible="{Binding HasAccounts}"
                     TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Button Grid.Column="3" Classes="link" Content="Settings" Command="{Binding ToggleSettings}" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <TextBlock Classes="warn" Text="{Binding FlavorWarning}" IsVisible="{Binding HasFlavorWarning}" />

    <!-- How things stand, and the one next step -->
    <Border Classes="headline"
            Classes.good="{Binding IsGood}" Classes.info="{Binding IsInfo}"
            Classes.attention="{Binding IsAttention}" Classes.problem="{Binding IsProblem}">
      <StackPanel Spacing="4">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
          <TextBlock Grid.Column="0" Classes="title" Text="{Binding Title}" />
          <Button Grid.Column="1" Content="Got it" Command="{Binding GotIt}" IsVisible="{Binding Dismissable}" VerticalAlignment="Top" />
        </Grid>
        <TextBlock Text="{Binding Next}" IsVisible="{Binding HasNext}" />
        <!-- Said whatever the headline is: a player who follows the next step and then waits
             for a portrait has to know nothing happens by itself. -->
        <Border IsVisible="{Binding Paused}" HorizontalAlignment="Left" Background="{DynamicResource AttentionPaneBrush}"
                BorderBrush="{DynamicResource AttentionBrush}" BorderThickness="1" CornerRadius="6" Padding="8,2">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="Automatic processing is off" VerticalAlignment="Center" Foreground="{DynamicResource AttentionBrush}" />
            <Button Classes="link" Content="Turn on" Command="{Binding Resume}" />
          </StackPanel>
        </Border>

        <!-- The first start: nothing is converted until this is read and answered. -->
        <StackPanel Spacing="8" IsVisible="{Binding FirstStart}" Margin="0,4,0,0">
          <TextBlock Text="{Binding FirstStartText}" />
          <CheckBox IsChecked="{Binding KeepScreenshots}" Content="Keep original capture screenshots" />
          <Button Content="Start watching" Command="{Binding StartWatching}" HorizontalAlignment="Right" />
        </StackPanel>

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
          <TextBlock Grid.Column="0" Classes="dim" Text="{Binding Activity}" IsVisible="{Binding HasActivity}" />
          <Button Grid.Column="1" Classes="link" Content="{Binding Problems}" IsVisible="{Binding HasProblems}"
                  Command="{Binding ToggleHelp}" Foreground="{DynamicResource AttentionBrush}" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- A new addon folder: the game has to be restarted once -->
    <Border IsVisible="{Binding RestartNotice}" Padding="14,10" CornerRadius="8"
            BorderThickness="1" BorderBrush="{DynamicResource AttentionBrush}"
            Background="{DynamicResource AttentionPaneBrush}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <TextBlock Grid.Column="0" Text="{Binding RestartNoticeText}" />
        <Button Grid.Column="1" Content="Dismiss" VerticalAlignment="Top" Command="{Binding DismissRestartNotice}" />
      </Grid>
    </Border>

    <!-- The collection -->
    <Border Classes="pane" Padding="14,6" IsVisible="{Binding Started}">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="2">
        <TextBlock Grid.Row="0" Grid.Column="0" Classes="heading" VerticalAlignment="Center">
          <Run Text="Your portraits · " /><Run Text="{Binding Count}" />
        </TextBlock>
        <Button Grid.Row="0" Grid.Column="1" Content="Check for new captures" Command="{Binding Check}" />
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="warn" Text="{Binding Attention}" IsVisible="{Binding HasAttention}" />
        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Classes="dim" Text="{Binding AddHint}" />
      </Grid>
    </Border>
   </StackPanel>

    <Border Grid.Row="1" Classes="data" IsVisible="{Binding Started}" ClipToBounds="True" Margin="14,0">
      <Panel>
        <TextBlock Classes="dim" IsVisible="{Binding !HasPortraits}" Margin="14"
                   Text="Nothing here yet." />
        <ScrollViewer IsVisible="{Binding HasPortraits}">
          <ItemsControl ItemsSource="{Binding Portraits}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="app:PortraitLine">
                <Border BorderBrush="{DynamicResource RimBrush}" BorderThickness="0,0,0,1" Padding="14,7"
                        ToolTip.Tip="{Binding Tooltip}">
                  <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="2">
                    <!-- The portrait, as the game draws it; the slot stays when there is none -->
                    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Classes="thumb">
                      <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                    </Border>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <Ellipse Classes="dot" Fill="{DynamicResource GoodBrush}" IsVisible="{Binding Ready}" />
                      <Ellipse Classes="dot" Fill="{DynamicResource AttentionBrush}" IsVisible="{Binding !Ready}" />
                      <TextBlock Text="{Binding State}" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Summary}" IsVisible="{Binding HasSummary}"
                               Classes.dim="{Binding Quiet}" Classes.warn="{Binding Attention}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Panel>
    </Border>

    <!-- Help: how it works, where the files are, what was left out and why -->
   <StackPanel Grid.Row="2" Spacing="10" Margin="14,0">
    <Border Classes="pane" IsVisible="{Binding ShowHelp}">
     <ScrollViewer MaxHeight="260">
      <StackPanel Spacing="8">
        <TextBlock Text="How it works" FontWeight="SemiBold" />
        <ItemsControl ItemsSource="{Binding HowItWorks}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Classes="dim" Text="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- A row that takes another button (issue #2: "Save diagnostics...") -->
        <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
          <Button Content="Open Cutouts folder" Command="{Binding OpenCutouts}" />
          <Button Content="Open log" Command="{Binding OpenLog}" />
        </WrapPanel>
        <StackPanel Spacing="3" IsVisible="{Binding HasWarnings}">
          <TextBlock Text="Warnings" FontWeight="SemiBold" />
          <ItemsControl ItemsSource="{Binding Warnings}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Classes="warn" Text="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <TextBlock Classes="dim" Margin="0,6,0,0"
                   Text="World of Warcraft is a trademark or registered trademark of Blizzard Entertainment, Inc., in the U.S. and/or other countries." />
      </StackPanel>
     </ScrollViewer>
    </Border>

    <Border Classes="pane" Padding="14,4">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
        <Ellipse Grid.Column="0" Classes="dot" Fill="{DynamicResource GoodBrush}" />
        <TextBlock Grid.Column="1" Classes="dim" VerticalAlignment="Center"
                   Text="Runs in the background: closing this window leaves it in the tray." />
        <Button Grid.Column="2" Classes="link" Content="Help" Command="{Binding ToggleHelp}" />
      </Grid>
    </Border>
   </StackPanel>
   </Grid>
  </Grid>
</Window>
